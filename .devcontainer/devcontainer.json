{
  "name": "VLESS",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "idleTimeout": "240m",
  "postAttachCommand": {
    "public": "gh codespace ports visibility 443:public -c $CODESPACE_NAME",
    "show-link": "echo '📄 VLESS link saved in vless.txt' && cat vless.txt"
  },
  "portsAttributes": {
    "443": {
      "label": "xray",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
